FROM node:20-alpine

WORKDIR /app

# Puppeteer runtime: используем системный chromium из alpine, не качаем свой.
# Старая переменная PUPPETEER_SKIP_CHROMIUM_DOWNLOAD заменена на
# PUPPETEER_SKIP_DOWNLOAD начиная с puppeteer 19; ставим обе для совместимости.
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    dumb-init \
    git

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Сначала ставим зависимости — слой кэшируется отдельно от исходников
COPY package*.json ./
RUN npm ci

# Копируем исходники (на этапе билда; в compose поверх ляжет bind-mount,
# но эта копия нужна чтобы npm run build:workers отработал в образе и
# чтобы первый старт без bind-mount тоже работал).
COPY . .

# Собираем worker-скрипты заранее: в dev compose'е bind-mount затрёт dist,
# поэтому повторно зовём build:workers через postinstall-эквивалент в
# entrypoint'е сервиса crypto-data-worker (в docker-compose.dev.yml
# command'ом npm run dev). Здесь это нужно как fallback и для прод-веток.
RUN npm run build:workers || true

# Дефолтная команда переопределяется в compose per-service
CMD ["npm", "run", "dev"]
