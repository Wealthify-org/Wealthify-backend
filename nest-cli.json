{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/wealthify-backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "assets": {
      "type": "application",
      "root": "apps/assets",
      "entryFile": "main",
      "sourceRoot": "apps/assets/src",
      "compilerOptions": {
        "tsConfigPath": "apps/assets/tsconfig.app.json"
      }
    },
    "crypto-data-worker": {
      "type": "application",
      "root": "apps/crypto-data-worker",
      "entryFile": "main",
      "sourceRoot": "apps/crypto-data-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/crypto-data-worker/tsconfig.app.json"
      }
    },
    "identity": {
      "type": "application",
      "root": "apps/identity",
      "entryFile": "main",
      "sourceRoot": "apps/identity/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity/tsconfig.app.json"
      }
    },
    "indexes-data-worker": {
      "type": "application",
      "root": "apps/indexes-data-worker",
      "entryFile": "main",
      "sourceRoot": "apps/indexes-data-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/indexes-data-worker/tsconfig.app.json"
      }
    },
    "portfolio-core": {
      "type": "application",
      "root": "apps/portfolio-core",
      "entryFile": "main",
      "sourceRoot": "apps/portfolio-core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/portfolio-core/tsconfig.app.json"
      }
    },
    "stock-data-worker": {
      "type": "application",
      "root": "apps/stock-data-worker",
      "entryFile": "main",
      "sourceRoot": "apps/stock-data-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stock-data-worker/tsconfig.app.json"
      }
    }
  }
}